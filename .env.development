VITE_APP_ENV=dev

# 开发期直连本机 wrangler dev（在 server/ 下 `npm run dev`）。
#
# 为什么不用线上地址：Cloudflare 的 *.workers.dev 在境内被 DNS 污染，
# 整条域名解析到 Facebook 的地址段，开发者工具根本连不上。
# 等绑了自己的域名再换成 https://api.<你的域名>。
#
# 改完这个文件必须重启 `npm run dev:mp-weixin` —— Vite 是在构建时
# 把 import.meta.env 内联进产物的，热更新不会重新读 .env。
VITE_API_BASE_URL=http://127.0.0.1:8787
VITE_USE_MOCK=false
