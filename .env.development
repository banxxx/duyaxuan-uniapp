VITE_APP_ENV=dev

# 开发期直连云端 Worker（自定义域名，已绑在 server/wrangler.toml 的 routes 里）。
#
# 为什么不用 *.workers.dev：这个域名在境内被 DNS 污染，解析到 Facebook 的地址段，
# 开发者工具和真机都连不上；换成自己域名下的子域才能稳定访问。
#
# 想改回「本机 wrangler dev + 本地 D1/R2」，把下面这行换成 http://127.0.0.1:8787，
# 并删掉 .env.development.local（真机则填电脑的局域网 IP）。
#
# 改完必须重启 `npm run dev:mp-weixin` —— Vite 是在构建时把 import.meta.env
# 内联进产物的，热更新不会重新读 .env。
VITE_API_BASE_URL=https://api.banxxx.cc.cd
VITE_USE_MOCK=false
