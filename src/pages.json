{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^App(.*)": "@/components/base/App$1.vue",
      "^(Poll|Status|Type|Empty)(.*)": "@/components/business/$1$2.vue"
    }
  },
  "pages": [
    {
      "path": "pages/login/index",
      "style": { "navigationStyle": "custom" }
    },
    {
      "path": "pages/index/index",
      "style": { "navigationStyle": "custom", "enablePullDownRefresh": true }
    },
    {
      "path": "pages/search/index",
      "style": { "navigationStyle": "custom" }
    },
    {
      "path": "pages/me/index",
      "style": { "navigationStyle": "custom" }
    },
    {
      "path": "pages/me/created",
      "style": { "navigationStyle": "custom", "enablePullDownRefresh": true }
    },
    {
      "path": "pages/me/joined",
      "style": { "navigationStyle": "custom", "enablePullDownRefresh": true }
    },
    {
      "path": "pages/me/pending",
      "style": { "navigationStyle": "custom", "enablePullDownRefresh": true }
    }
  ],
  "subPackages": [
    {
      "root": "pages/detail",
      "pages": [
        {
          "path": "index",
          "style": { "navigationStyle": "custom" }
        },
        {
          "path": "success",
          "style": { "navigationStyle": "custom" }
        },
        {
          "path": "result",
          "style": { "navigationStyle": "custom" }
        },
        {
          "path": "voters",
          "style": { "navigationStyle": "custom", "enablePullDownRefresh": true }
        },
        {
          "path": "comments",
          "style": { "navigationStyle": "custom" }
        }
      ]
    },
    {
      "root": "pages/share",
      "pages": [
        {
          "path": "index",
          "style": { "navigationStyle": "custom" }
        },
        {
          "path": "join",
          "style": { "navigationStyle": "custom" }
        }
      ]
    },
    {
      "root": "pages/create",
      "pages": [
        {
          "path": "type",
          "style": { "navigationStyle": "custom" }
        },
        {
          "path": "content",
          "style": { "navigationStyle": "custom" }
        },
        {
          "path": "rules",
          "style": { "navigationStyle": "custom" }
        },
        {
          "path": "success",
          "style": { "navigationStyle": "custom" }
        }
      ]
    },
    {
      "root": "pages/creator",
      "pages": [
        {
          "path": "data",
          "style": { "navigationStyle": "custom", "enablePullDownRefresh": true }
        },
        {
          "path": "edit-content",
          "style": { "navigationStyle": "custom" }
        },
        {
          "path": "edit-rules",
          "style": { "navigationStyle": "custom" }
        }
      ]
    },
    {
      "root": "pages/survey",
      "pages": [
        {
          "path": "fill",
          "style": { "navigationStyle": "custom" }
        },
        {
          "path": "done",
          "style": { "navigationStyle": "custom" }
        },
        {
          "path": "mine",
          "style": { "navigationStyle": "custom", "enablePullDownRefresh": true }
        },
        {
          "path": "edit-answer",
          "style": { "navigationStyle": "custom" }
        },
        {
          "path": "answers",
          "style": { "navigationStyle": "custom", "enablePullDownRefresh": true }
        }
      ]
    },
    {
      "root": "pages/summary",
      "pages": [
        {
          "path": "index",
          "style": { "navigationStyle": "custom" }
        },
        {
          "path": "option",
          "style": { "navigationStyle": "custom" }
        },
        {
          "path": "unclassified",
          "style": { "navigationStyle": "custom" }
        }
      ]
    },
    {
      "root": "pages/settings",
      "pages": [
        {
          "path": "index",
          "style": { "navigationStyle": "custom" }
        },
        {
          "path": "notifications",
          "style": { "navigationStyle": "custom" }
        },
        {
          "path": "account",
          "style": { "navigationStyle": "custom" }
        },
        {
          "path": "wechat",
          "style": { "navigationStyle": "custom" }
        },
        {
          "path": "bind",
          "style": { "navigationStyle": "custom" }
        },
        {
          "path": "deactivate",
          "style": { "navigationStyle": "custom" }
        },
        {
          "path": "doc",
          "style": { "navigationStyle": "custom" }
        }
      ]
    },
    {
      "root": "pages/support",
      "pages": [
        {
          "path": "index",
          "style": { "navigationStyle": "custom" }
        }
      ]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "all",
      "packages": ["pages/detail"]
    },
    "pages/me/index": {
      "network": "wifi",
      "packages": ["pages/settings"]
    }
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "杜雅轩",
    "navigationBarBackgroundColor": "#FAFAFA",
    "backgroundColor": "#FAFAFA",
    "backgroundColorTop": "#FAFAFA",
    "backgroundColorBottom": "#FAFAFA"
  },
  "tabBar": {
    "custom": true,
    "color": "#A1A1AA",
    "selectedColor": "#4F46E5",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "white",
    "list": [
      { "pagePath": "pages/index/index", "text": "发现" },
      { "pagePath": "pages/me/index", "text": "我的" }
    ]
  }
}
