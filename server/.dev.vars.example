# 本地调试用：复制成 .dev.vars 再填。
# .dev.vars 已在 .gitignore 里，不会被提交。
#
# 线上不用这个文件 —— 线上是 npx wrangler secret put <NAME> 写进 Cloudflare 的加密环境变量。
#
# 本地调试如果不想去微信后台拿真实 AppID，WX_APPID / WX_SECRET 随便填，
# 只是本地调用 /auth/login 会失败（拿不到 openid）。想本地跑通登录就填真的。
WX_APPID=wx0000000000000000
WX_SECRET=00000000000000000000000000000000
JWT_SECRET=local-dev-only-change-me-to-a-long-random-string
TOKEN_TTL_DAYS=7

# 开发期免授权登录（/auth/dev-accounts、/auth/dev-login）。
# 本地填 true 就能在「设置 · 关于我们」长按切换测试账号；线上绝对不要配置。
DEV_LOGIN=false

# 小程序码指向的版本：release / trial / develop。本地开发用 develop。
# 这个版本得先在开发者工具里「上传」过，否则扫码会提示「开发版/体验版不存在」
# WX_ENV_VERSION=develop

# 订阅消息模板 ID（微信后台 → 功能 → 订阅消息 → 我的模板）。
# 不填就只发站内消息，功能照常跑；填了才会真的推服务通知。
#
# 只有一个通用模板（活动名称/活动内容/活动日期）时，填这一行就够，
# 参与、评论、截止提醒共用它：
# WX_TMPL_NOTIFY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# 想按类型分开推（用户看到的模板标题不同），再单独配这几类；
# 单独配置优先于 WX_TMPL_NOTIFY：
# WX_TMPL_JOINED=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # 有人参与 / 收到回答
# WX_TMPL_COMMENT=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx  # 新的评论、回复
# WX_TMPL_DEADLINE=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx # 结束前 2 小时提醒
# WX_TMPL_RESULT=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # 结果公布（参与者 + 发起人）
# WX_TMPL_UPDATED=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx  # 我参与的内容有更新
#
# 模板字段名对不上时（微信返回 47003），用这个变量覆盖，不用改代码。
# 默认对应「活动名称{{thing4.DATA}} / 活动内容{{thing2.DATA}} / 活动日期{{time20.DATA}}」：
# WX_TMPL_FIELDS={"title":"thing4","content":"thing2","time":"time20"}
