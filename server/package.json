{
  "name": "duyaxuan-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "投票吧后端 · Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute duyaxuan-db --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute duyaxuan-db --remote --file=./schema.sql",
    "seed": "node scripts/seed.mjs",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "typescript": "^5.0.0",
    "wrangler": "^4.0.0"
  }
}
